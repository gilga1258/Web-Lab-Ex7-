<!DOCTYPE html>
<html>
<head>
<title>Budget Calculator</title>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<style>
body {
    font-family: Arial;
    text-align: center;
    background: lightblue;
}
.box {
    background: white;
    width: 350px;
    margin: 50px auto;
    padding: 20px;
    border-radius: 10px;
}
input {
    padding: 8px;
    margin: 8px;
    width: 150px;
}
button {
    padding: 10px;
    background: green;
    color: white;
    border: none;
    cursor: pointer;
}
</style>
</head>
<body>
<div class="box">
<h2>Budget Calculator</h2>
<label>Total Amount:</label><br>
<input type="number" id="amount"><br>
<label>Room Rent (%):</label><br>
<input type="number" id="rent" value="30"><br>
<label>Accessories (%):</label><br>
<input type="number" id="accessories" value="20"><br>
<label>Emergency (%):</label><br>
<input type="number" id="emergency" value="20"><br>
<label>Saving (%):</label><br>
<input type="number" id="saving" value="30"><br>
<button id="evaluate">Evaluate My Money</button>
<h3>Results</h3>
<p>Room Rent: <span id="r1">0</span></p>
<p>Accessories: <span id="r2">0</span></p>
<p>Emergency: <span id="r3">0</span></p>
<p>Saving: <span id="r4">0</span></p>
</div>
<script>
$(document).ready(function() {
    $("#evaluate").click(function() {
        var amount = Number($("#amount").val());
        var rent = Number($("#rent").val());
        var accessories = Number($("#accessories").val());
        var emergency = Number($("#emergency").val());
        var saving = Number($("#saving").val());
        var total = rent + accessories + emergency + saving;

        if ($("#amount").val() == "" || amount <= 0) {
            alert("Enter a valid amount!");
        }
        else if (rent < 0 || accessories < 0 ||
                 emergency < 0 || saving < 0 ||
                 total != 100) {
            alert("Percentage values must add up to 100!");
        }
        else {
            $("#r1").text(amount * rent / 100);
            $("#r2").text(amount * accessories / 100);
            $("#r3").text(amount * emergency / 100);
            $("#r4").text(amount * saving / 100);
        }
    });
});
</script>
</body>
</html>

